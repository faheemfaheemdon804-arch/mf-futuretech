# Site ka live URL — domain final hone par daalein, jaise https://yourdomain.com (canonical, sitemap, OG ke liye)
NEXT_PUBLIC_SITE_URL=

# Supabase (Auth, orders, leads, guest post sites) — supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sirf server par (kabhi client/GitHub par nahi)
SUPABASE_SERVICE_ROLE_KEY=

# Resend (order / contact emails) — resend.com
RESEND_API_KEY=
# Domain verify hone ke baad apna address daalein; tab tak Resend ka test sender chalega
EMAIL_FROM="mffuturetech <onboarding@resend.dev>"
